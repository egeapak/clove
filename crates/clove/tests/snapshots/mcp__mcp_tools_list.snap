  {
    "description": "Set or clear an item's parent (epic membership). Omit `parent` to clear it. Rejects self-parenting and parent cycles.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "The item whose parent to set.",
          "type": "string"
        },
        "parent": {
          "description": "The new parent id, or null/omitted to clear the parent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "title": "SetParentArgs",
      "type": "object"
    },
    "name": "clove_set_parent"
  },
  {
    "description": "Show one work item: its fields, the Markdown body, comment count, and computed `ready`/`blocked_by`.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Result-shaping options shared by the read tools.",
      "properties": {
        "compact": {
          "description": "Omit null and empty-list keys. Defaults to true unless `fields` is given.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fields": {
          "description": "Return only these keys per item (e.g. [\"id\",\"title\",\"status\"]). Unknown\nnames are ignored. Cuts list payloads by roughly two thirds.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "id": {
          "description": "The item id (e.g. `proj-7af3q2k9`).",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "IdArgs",
      "type": "object"
    },
    "name": "clove_show"
  },
  {
    "description": "Repository analytics: counts by status/type/priority/assignee/label, ready/blocked/excluded/dangling totals, cycle count, per-epic rollups, and throughput.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "no_epics": {
          "description": "Skip the per-epic completion rollup.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "top": {
          "description": "Cap assignee/label breakdowns to the N highest (0 = no cap; default 10).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "StatsArgs",
      "type": "object"
    },
    "name": "clove_stats"
  },
  {
    "description": "Change an item's status (open | in_progress | closed). Closing sets the closed timestamp; reopening clears it.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "The item id.",
          "type": "string"
        },
        "status": {
          "description": "New status: `open`, `in_progress`, or `closed`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "StatusArgs",
      "type": "object"
    },
    "name": "clove_status"
  }
